# ── Database — two URLs required ──────────────────────────────────────────────
# FastAPI uses asyncpg (async); Celery worker + Alembic use psycopg2 (sync)
DATABASE_URL=postgresql+asyncpg://user:pass@localhost:5432/taskdb
DATABASE_SYNC_URL=postgresql+psycopg2://user:pass@localhost:5432/taskdb

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── Groq API (free tier — get key at console.groq.com) ───────────────────────
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
LLM_MODEL=llama-3.3-70b-versatile

# ── Org defaults ──────────────────────────────────────────────────────────────
# Used when no per-email timezone is provided (IANA tz string)
ORG_TIMEZONE=Asia/Kolkata

# ── Security ──────────────────────────────────────────────────────────────────
# Shared secret for POST /ingest (JSON endpoint for curl / tests / Gmail)
WEBHOOK_SECRET=change-me-to-a-long-random-string

# ── Pipeline tuning ───────────────────────────────────────────────────────────
LLM_CONFIDENCE_THRESHOLD=0.60
DEFAULT_EMPLOYEE_CAPACITY=3
URGENCY_DEADLINE_HOURS=24

# ── Scoring weights — normal tasks (must sum to 1.0) ─────────────────────────
SCORING_WEIGHTS_SKILLS=0.40
SCORING_WEIGHTS_AVAILABILITY=0.30
SCORING_WEIGHTS_PERFORMANCE=0.20
SCORING_WEIGHTS_SENIORITY=0.10

# ── Scoring weights — urgent tasks (deadline < URGENCY_DEADLINE_HOURS) ───────
# Shifts weight toward availability to find the most-free person quickly
URGENCY_WEIGHTS_SKILLS=0.30
URGENCY_WEIGHTS_AVAILABILITY=0.45
URGENCY_WEIGHTS_PERFORMANCE=0.15
URGENCY_WEIGHTS_SENIORITY=0.10

# ── Auto-rating applied on task completion ────────────────────────────────────
AUTO_RATING_ON_TIME=4.0
AUTO_RATING_LATE=2.0
